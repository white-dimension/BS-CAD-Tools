<UserControl x:Class="BS.CAD.Tools.Views.MainPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="360"
             Background="#111417">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#111417"/>
        <SolidColorBrush x:Key="PanelBg2" Color="#171B20"/>
        <SolidColorBrush x:Key="CardBg" Color="#1D2228"/>
        <SolidColorBrush x:Key="CardBgSoft" Color="#232931"/>
        <SolidColorBrush x:Key="CardBorder" Color="#343B45"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="TextSub" Color="#AAB4C0"/>
        <SolidColorBrush x:Key="TextMute" Color="#77818D"/>
        <SolidColorBrush x:Key="Accent" Color="#3578F6"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1B376D"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB84D"/>
        <SolidColorBrush x:Key="Danger" Color="#EF6B6B"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#3A2527"/>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="30"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="18"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PillStyle" TargetType="Border">
            <Setter Property="Background" Value="#27303A"/>
            <Setter Property="BorderBrush" Value="#3A4552"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#2A3038"/>
            <Setter Property="BorderBrush" Value="#434C56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333B45"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#56616D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#242A31"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#5A91FF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="BorderBrush" Value="#7A3E45"/>
            <Setter Property="Foreground" Value="#FFEDEE"/>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#20262D"/>
            <Setter Property="BorderBrush" Value="#3D4650"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#111417"/>
        </Style>

        <Style x:Key="ModuleExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,14,14,18">

                <Border CornerRadius="18" Padding="16" Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#222A35" Offset="0"/>
                            <GradientStop Color="#15191E" Offset="0.72"/>
                            <GradientStop Color="#10213D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#46515E" Offset="0"/>
                            <GradientStop Color="#26303A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="CAD助手" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="BS-CAD-Tools · 日常绘图工具箱"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSub}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>

                        <Button Grid.Row="0" Grid.Column="1"
                                Content="模块"
                                Width="58"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnBtnModuleSettingsClick"
                                ToolTip="启用或隐藏主面板功能模块。"/>

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource PillStyle}" Margin="0,0,6,0">
                                <TextBlock Text="模块化" Foreground="{StaticResource TextSub}" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource PillStyle}" Margin="0,0,6,0">
                                <TextBlock Text="安全确认" Foreground="{StaticResource TextSub}" FontSize="11"/>
                            </Border>
                            <Border Style="{StaticResource PillStyle}">
                                <TextBlock Text="本地设置" Foreground="{StaticResource TextSub}" FontSize="11"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Background="#1A2027">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="4" CornerRadius="99" Background="{StaticResource Warn}" Margin="0,1,12,1"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="当前状态" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="TxtCurrentIME"
                                       Text="输入法监测中..."
                                       FontSize="13"
                                       Foreground="{StaticResource Warn}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="LayerToolsPanel" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource PillStyle}" Background="{StaticResource AccentSoft}" BorderBrush="#2F5FAB">
                                <TextBlock Text="LY" Foreground="#AFCBFF" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="图层工具" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                        <TextBlock Text="打开轻量图层管理器，用于日常切层、筛选，以及颜色/线型/透明度调整。"
                                   Style="{StaticResource HintTextStyle}"/>
                        <Button Content="打开图层管理器" Style="{StaticResource PrimaryButtonStyle}" Click="OnBtnLayerManagerClick"
                                ToolTip="执行 LY：打开图层管理器，不直接修改图纸。"/>
                    </StackPanel>
                </Border>

                <Expander x:Name="ImeToolsPanel" Header="自动切换输入法" IsExpanded="True" Style="{StaticResource ModuleExpanderStyle}">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource PillStyle}">
                                    <TextBlock Text="IME" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="自动切换输入法" Style="{StaticResource SectionTitleStyle}"/>
                            </DockPanel>
                            <TextBlock Text="用于文字编辑时切中文、结束后切英文。建议中文输入法 + 美式键盘各保留一个。"
                                       Style="{StaticResource HintTextStyle}"/>

                            <TextBlock Text="中文输入法" Style="{StaticResource LabelTextStyle}"/>
                            <ComboBox x:Name="ComboChineseIME"/>

                            <TextBlock Text="英文键盘" Style="{StaticResource LabelTextStyle}"/>
                            <ComboBox x:Name="ComboEnglishIME"/>

                            <Button Content="启动输入法自动切换" Style="{StaticResource PrimaryButtonStyle}" Click="OnBtnSaveIMESettingsClick"
                                    ToolTip="保存当前选择的中文/英文输入法。"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander x:Name="FontToolsPanel" Header="字体工具" IsExpanded="False" Style="{StaticResource ModuleExpanderStyle}">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Border DockPanel.Dock="Right" Style="{StaticResource PillStyle}">
                                    <TextBlock Text="TEXT" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="字体工具" Style="{StaticResource SectionTitleStyle}"/>
                            </DockPanel>
                            <TextBlock Text="修复全图文字样式前建议先保存图纸。"
                                       Foreground="{StaticResource Warn}"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="目标字体" Style="{StaticResource LabelTextStyle}"/>
                            <ComboBox x:Name="ComboShx" IsEditable="True"/>

                            <TextBlock Text="备选大字体" Style="{StaticResource LabelTextStyle}"/>
                            <ComboBox x:Name="ComboBoxBig" IsEditable="True"/>

                            <Button Content="修复全图字体  FIXFONTS" Style="{StaticResource DangerButtonStyle}" Click="OnBtnFixFontsClick"
                                    ToolTip="执行 FIXFONTS：会修改全图文字样式，执行前会再次确认。"/>
                            <Button Content="标准化文字  TS" Style="{StaticResource ToolButtonStyle}" Click="OnBtnTextStandardClick"
                                    ToolTip="执行 TS：快速设置为预设文字字体。"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border x:Name="CleanupToolsPanel" Style="{StaticResource CardStyle}" Background="#201D20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource PillStyle}" Background="#3A2527" BorderBrush="#704149">
                                <TextBlock Text="谨慎" Foreground="#FFB8BE" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="图纸清理" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                        <TextBlock Text="这些操作会修改当前图纸，执行前会弹出确认。建议先保存图纸。"
                                   Foreground="{StaticResource Warn}"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="全图物体随层  SETBYLAYER" Style="{StaticResource DangerButtonStyle}" Click="OnBtnByLayerClick"
                                ToolTip="执行 SETBYLAYER：把对象颜色、线型、线宽改为 ByLayer。建议先保存图纸。"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StandardToolsPanel" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource PillStyle}">
                                <TextBlock Text="TEST" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="标准环境" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                        <TextBlock Text="当前仍是测试入口，暂未对接 BS-CAD-Standard。"
                                   Foreground="{StaticResource Warn}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="标准环境初始化  BZ" Style="{StaticResource ToolButtonStyle}" Click="OnBtnStandardClick"
                                ToolTip="执行 BZ：当前仍是测试入口，暂未对接 BS-CAD-Standard。"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#0D1013" BorderBrush="#252B32" BorderThickness="0,1,0,0" Padding="12,9">
            <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
