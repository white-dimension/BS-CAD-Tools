<UserControl x:Class="BS.CAD.Tools.Views.MainPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="360"
             Background="#111417">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#111417"/>
        <SolidColorBrush x:Key="CardBg" Color="#1D2228"/>
        <SolidColorBrush x:Key="CardBorder" Color="#343B45"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="TextSub" Color="#AAB4C0"/>
        <SolidColorBrush x:Key="TextMute" Color="#77818D"/>
        <SolidColorBrush x:Key="Accent" Color="#3578F6"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#1B376D"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB84D"/>
        <SolidColorBrush x:Key="Danger" Color="#EF6B6B"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#3A2527"/>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="BadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#243140"/>
            <Setter Property="BorderBrush" Value="#405066"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,3"/>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#2A3038"/>
            <Setter Property="BorderBrush" Value="#434C56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333B45"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#56616D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#242A31"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#5A91FF"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="BorderBrush" Value="#7A3E45"/>
            <Setter Property="Foreground" Value="#FFEDEE"/>
        </Style>

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#20262D"/>
            <Setter Property="BorderBrush" Value="#3D4650"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DarkComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#161B21"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263140"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2E3E57"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#4A5563"
                                BorderBrush="#687484"
                                BorderThickness="1"
                                CornerRadius="4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Background" Value="#151B22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Opacity="0"
                                                  Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkPickerComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#14191F"/>
            <Setter Property="BorderBrush" Value="#38424D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <ContentPresenter Margin="10,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Border Width="34"
                                    HorizontalAlignment="Right"
                                    CornerRadius="0,8,8,0"
                                    Background="#1D2430"
                                    BorderBrush="#38424D"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Text="▼"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSub}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240"
                                        Margin="0,4,0,0"
                                        Background="#12171D"
                                        BorderBrush="#38424D"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkComboScrollBarStyle}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#4A5A6D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#5A91FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="DarkEditableComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#14191F"/>
            <Setter Property="BorderBrush" Value="#38424D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="OuterBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"/>
                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="10,0,38,0"
                                     VerticalAlignment="Center"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextMain}"
                                     CaretBrush="{StaticResource TextMain}"
                                     SelectionBrush="#4E7FD0"
                                     FontSize="{TemplateBinding FontSize}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="10,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Border Width="34"
                                    HorizontalAlignment="Right"
                                    CornerRadius="0,8,8,0"
                                    Background="#1D2430"
                                    BorderBrush="#38424D"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Text="▼"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSub}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ToggleButton HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Margin="0,4,0,0"
                                        Background="#12171D"
                                        BorderBrush="#38424D"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkComboScrollBarStyle}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsEditable" Value="False">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#4A5A6D"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="#5A91FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OuterBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#111417"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ModuleCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ModuleContentFrameStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="8,0,8,8"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ModuleHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="HeaderBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="18"
                                        Height="18"
                                        Margin="16,0,8,0"
                                        Background="#F6F8FA"
                                        CornerRadius="9"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Path x:Name="Arrow"
                                          Width="8"
                                          Height="5"
                                          Stretch="Fill"
                                          Fill="#1D2228"
                                          Data="M 0 5 L 4 0 L 8 5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RenderTransformOrigin="0.5,0.5"/>
                                </Border>
                                <ContentPresenter Grid.Column="1"
                                                  Margin="0,0,10,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderBg" Property="Background" Value="#20262D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource PanelBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkComboScrollBarStyle}"/>
            </ScrollViewer.Resources>
            <StackPanel Margin="10,10,10,12">

                <Border CornerRadius="12" Padding="14,10" Margin="0,0,0,10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#202833" Offset="0"/>
                            <GradientStop Color="#15191E" Offset="0.75"/>
                            <GradientStop Color="#10213D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#46515E" Offset="0"/>
                            <GradientStop Color="#26303A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CAD助手" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="BS-CAD-Tools · 日常绘图工具箱"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSub}"
                                        Margin="0,3,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="模块设置"
                                MinWidth="76"
                                Style="{StaticResource GhostButtonStyle}"
                                Click="OnBtnModuleSettingsClick"
                                ToolTip="启用或隐藏主面板功能模块。"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Background="#1A2027" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}" Visibility="Collapsed">
                            <TextBlock Text="IME" Foreground="#AFCBFF" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="当前状态" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="TxtCurrentIME"
                                       Text="输入法监测中..."
                                       FontSize="12"
                                       Foreground="{StaticResource Warn}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border x:Name="LayerToolsPanel" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}" Background="{StaticResource AccentSoft}" BorderBrush="#2F5FAB">
                                <TextBlock Text="LY" Foreground="#AFCBFF" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="图层工具" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                        <TextBlock Text="打开轻量图层管理器，用于日常切层、筛选，以及颜色/线型/透明度调整。"
                                   Style="{StaticResource HintTextStyle}"/>
                        <Button Content="打开图层管理器" Style="{StaticResource PrimaryButtonStyle}" Click="OnBtnLayerManagerClick"
                                ToolTip="执行 LY：打开图层管理器，不直接修改图纸。"/>
                    </StackPanel>
                </Border>

                <Border x:Name="ImeToolsPanel" Style="{StaticResource ModuleCardStyle}">
                    <StackPanel>
                        <ToggleButton x:Name="ImeModuleToggle"
                                      Content="自动切换输入法"
                                      IsChecked="True"
                                      Style="{StaticResource ModuleHeaderToggleStyle}"/>
                        <Border Style="{StaticResource ModuleContentFrameStyle}"
                                Visibility="{Binding IsChecked, ElementName=ImeModuleToggle, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
<TextBlock Text="用于文字编辑时切中文、结束后切英文。建议中文输入法和美式键盘各保留一个。"
                                       Style="{StaticResource HintTextStyle}"/>

                            <TextBlock Text="中文输入法" Style="{StaticResource LabelTextStyle}" Visibility="Collapsed"/>
                            <ComboBox x:Name="ComboChineseIME" Style="{StaticResource DarkPickerComboStyle}" Visibility="Collapsed"/>

                            <TextBlock Text="英文键盘" Style="{StaticResource LabelTextStyle}" Visibility="Collapsed"/>
                            <ComboBox x:Name="ComboEnglishIME" Style="{StaticResource DarkPickerComboStyle}" Visibility="Collapsed"/>

                            <Button Content="启动输入法自动切换" Style="{StaticResource PrimaryButtonStyle}" Click="OnBtnSaveIMESettingsClick"
                                    ToolTip="保存当前选择的中文/英文输入法。"/>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="FontToolsPanel" Style="{StaticResource ModuleCardStyle}">
                    <StackPanel>
                        <ToggleButton x:Name="FontModuleToggle"
                                      Content="字体工具"
                                      IsChecked="False"
                                      Style="{StaticResource ModuleHeaderToggleStyle}"/>
                        <Border Style="{StaticResource ModuleContentFrameStyle}"
                                Visibility="{Binding IsChecked, ElementName=FontModuleToggle, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
<TextBlock Text="修复全图文字样式前建议先保存图纸。"
                                       Foreground="{StaticResource Warn}"
                                       FontSize="12"
                                       LineHeight="18"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="目标字体" Style="{StaticResource LabelTextStyle}"/>
                            <ComboBox x:Name="ComboShx" IsEditable="True" Style="{StaticResource DarkEditableComboStyle}"/>

                            <TextBlock Text="备选大字体" Style="{StaticResource LabelTextStyle}"/>
                            <ComboBox x:Name="ComboBoxBig" IsEditable="True" Style="{StaticResource DarkEditableComboStyle}"/>

                            <Button Content="修复全图字体  FIXFONTS" Style="{StaticResource DangerButtonStyle}" Click="OnBtnFixFontsClick"
                                    ToolTip="执行 FIXFONTS：会修改全图文字样式，执行前会再次确认。"/>
                            <Button Content="标准化文字  TS" Style="{StaticResource ToolButtonStyle}" Click="OnBtnTextStandardClick"
                                    ToolTip="执行 TS：快速设置为预设文字字体。"/>
                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="CleanupToolsPanel" Style="{StaticResource CardStyle}" Background="#201D20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}" Background="#3A2527" BorderBrush="#704149">
                                <TextBlock Text="谨慎" Foreground="#FFB8BE" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="图纸清理" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                        <TextBlock Text="这些操作会修改当前图纸，执行前会弹出确认。建议先保存图纸。"
                                   Foreground="{StaticResource Warn}"
                                   FontSize="12"
                                   LineHeight="18"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        <Button Content="全图物体随层  SETBYLAYER" Style="{StaticResource DangerButtonStyle}" Click="OnBtnByLayerClick"
                                ToolTip="执行 SETBYLAYER：把对象颜色、线型、线宽改为 ByLayer。建议先保存图纸。"/>
                    </StackPanel>
                </Border>

                <Border x:Name="StandardToolsPanel" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <Border DockPanel.Dock="Right" Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="BS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="BS 标准工具" Style="{StaticResource SectionTitleStyle}"/>
                        </DockPanel>
                        <TextBlock Text="调用 BS-CAD-Standard 插件中的标准化命令。"
                                   Foreground="{StaticResource TextSub}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button Content="刷新检测" FontSize="11" Padding="6,2" DockPanel.Dock="Right"
                                    Background="#252B32" Foreground="{StaticResource TextSub}"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="OnBtnRefreshStandardStatusClick"/>
                            <TextBlock x:Name="TxtStandardPluginStatus" Text="BS-CAD-Standard：检测中..."
                                       Foreground="{StaticResource TextSub}" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                        <Button Content="初始化标准环境" Style="{StaticResource DangerButtonStyle}" Click="OnBtnBsInitClick"
                                ToolTip="执行 BS_INIT：初始化当前图纸标准环境。建议先保存图纸。"/>
                        <Button Content="检查图层标准" Style="{StaticResource ToolButtonStyle}" Click="OnBtnBsCheckClick"
                                ToolTip="执行 BS_CHECK"/>
                        <Button Content="补齐缺失图层" Style="{StaticResource DangerButtonStyle}" Click="OnBtnBsFixMissingClick"
                                ToolTip="执行 BS_FIX_MISSING：补齐缺失的标准图层。建议先保存图纸。"/>
                        <Button Content="检查 CTB 颜色规则" Style="{StaticResource ToolButtonStyle}" Click="OnBtnBsCtbCheckClick"
                                ToolTip="执行 BS_CTB_CHECK"/>
                        <Button Content="导出 CTB 编辑器表" Style="{StaticResource ToolButtonStyle}" Click="OnBtnBsCtbExportClick"
                                ToolTip="执行 BS_CTB_EXPORT"/>
                        <Button Content="模板基础环境检查" Style="{StaticResource ToolButtonStyle}" Click="OnBtnBsTemplateCheckClick"
                                ToolTip="执行 BS_TEMPLATE_CHECK"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#0D1013" BorderBrush="#252B32" BorderThickness="0,1,0,0" Padding="12,9" Visibility="Collapsed">
            <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
