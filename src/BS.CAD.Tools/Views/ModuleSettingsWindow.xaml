<Window x:Class="BS.CAD.Tools.Views.ModuleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模块管理"
        Width="390"
        Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#111417">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#111417"/>
        <SolidColorBrush x:Key="CardBg" Color="#1D2228"/>
        <SolidColorBrush x:Key="CardBorder" Color="#343B45"/>
        <SolidColorBrush x:Key="TextMain" Color="#F3F6FA"/>
        <SolidColorBrush x:Key="TextSub" Color="#AAB4C0"/>
        <SolidColorBrush x:Key="Accent" Color="#3578F6"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB84D"/>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="#2A3038"/>
            <Setter Property="BorderBrush" Value="#434C56"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333B45"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="#56616D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#242A31"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="#5A91FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PanelBg}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="16" Padding="16" Margin="0,0,0,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#222A35" Offset="0"/>
                    <GradientStop Color="#15191E" Offset="0.7"/>
                    <GradientStop Color="#10213D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <SolidColorBrush Color="#343B45"/>
            </Border.BorderBrush>
            <Border.BorderThickness>1</Border.BorderThickness>
            <StackPanel>
                <TextBlock Text="模块管理" Foreground="{StaticResource TextMain}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="只控制主面板显示，不会删除命令。保存后主面板立即刷新。"
                           Foreground="{StaticResource TextSub}"
                           FontSize="12"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="14" Padding="16">
            <StackPanel>
                <CheckBox x:Name="ChkLayerTools" Content="图层工具  LayerTools"/>
                <CheckBox x:Name="ChkImeTools" Content="输入法切换  ImeTools"/>
                <CheckBox x:Name="ChkFontTools" Content="字体工具  FontTools"/>
                <CheckBox x:Name="ChkCleanupTools" Content="图纸清理  CleanupTools"/>
                <CheckBox x:Name="ChkStandardTools" Content="标准环境  StandardTools"/>

                <Border Background="#2D271C" BorderBrush="#6F5622" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,16,0,0">
                    <TextBlock Text="建议：会修改图纸的图纸清理、标准环境模块默认关闭，需要时再开启。"
                               Foreground="{StaticResource Warn}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick" DockPanel.Dock="Right"/>
            <Button Content="取消" Style="{StaticResource ButtonStyle}" Click="OnCancelClick" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
